void loop()
{
    // Check if a key was sent from the computer
    if (Serial.available() > 0) {
        char key = tolower(Serial.read()); // Read the key and make it lowercase

        switch (key) {
            // --- DRIVING (WASD + Space) ---
            case 'w': // Forward
                leftmotor.forward();
                rightmotor.forward();
                break;

            case 's': // Backward
                leftmotor.backward();
                rightmotor.backward();
                break;

            case 'a': // Turn Left
                leftmotor.backward();
                rightmotor.forward();
                break;

            case 'd': // Turn Right
                leftmotor.forward();
                rightmotor.backward();
                break;

            case ' ': // Stop Drive Motors
                leftmotor.stop();
                rightmotor.stop();
                break;

            // --- SERVO GRAB / RELEASE (Q / E) ---
            case 'q': // Grab block
                carriageservo.write(_);
                delay(3);
                break;

            case 'e': // Release block
                carriageservo.write(_);
                delay(3);
                break;

            // --- CARRIAGE MOTOR (I / K / O) ---
            case 'i': // Carriage Forward
                carriagemotor.forward();
                break;

            case 'k': // Carriage Backward
                carriagemotor.backward();
                break;

            case 'o': // Carriage Stop
                carriagemotor.stop();
                break;
        }
    }
}
